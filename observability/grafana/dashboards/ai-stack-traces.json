      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "text",
      "title": "Drill-down guide",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Click a Trace ID** to open the span waterfall in Explore. **Click Cost & tokens** to open the cost dashboard filtered to the same chat session (LiteLLM `session_id` is the Tempo trace ID).\n\n**LLM spans** lists individual `gen_ai` spans with prompt/completion/total tokens and the input/output/cache/reasoning cost breakdown. Click **Span ID** to jump directly to that span in the trace."
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "ai-stack",
    "traces",
    "llm"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
