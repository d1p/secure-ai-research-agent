    {
      "id": 19,
      "type": "piechart",
      "title": "Cost by token type (selected range)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-litellm"
          },
          "rawSql": "WITH costs AS (SELECT GREATEST(COALESCE((metadata->'cost_breakdown'->>'input_cost')::float8,0) - COALESCE((metadata->'cost_breakdown'->>'cache_read_cost')::float8,0),0) AS input, COALESCE((metadata->'cost_breakdown'->>'cache_read_cost')::float8,0) AS cache_read, GREATEST(COALESCE((metadata->'cost_breakdown'->>'output_cost')::float8,0) - COALESCE((metadata->'cost_breakdown'->>'reasoning_cost')::float8,0),0) AS output, COALESCE((metadata->'cost_breakdown'->>'reasoning_cost')::float8,0) AS reasoning FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session') SELECT 'input (uncached)' AS \"type\", SUM(input) AS \"cost\" FROM costs UNION ALL SELECT 'cache read', SUM(cache_read) FROM costs UNION ALL SELECT 'output (non-reasoning)', SUM(output) FROM costs UNION ALL SELECT 'reasoning', SUM(reasoning) FROM costs",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Cache read is part of input and reasoning is part of output; this is a non-overlapping split."
    },
    {
      "id": 20,
      "type": "table",
      "title": "Cost per model by token type",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 32
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-litellm"
          },
          "rawSql": "SELECT model, ROUND(SUM(COALESCE((metadata->'cost_breakdown'->>'input_cost')::float8,0))::numeric,6) AS input_total, ROUND(SUM(COALESCE((metadata->'cost_breakdown'->>'output_cost')::float8,0))::numeric,6) AS output_total, ROUND(SUM(COALESCE((metadata->'cost_breakdown'->>'cache_read_cost')::float8,0))::numeric,6) AS cache_read, ROUND(SUM(COALESCE((metadata->'cost_breakdown'->>'reasoning_cost')::float8,0))::numeric,6) AS reasoning, ROUND(SUM(spend)::numeric,6) AS total_cost, SUM(\"total_tokens\") AS tokens FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' GROUP BY model ORDER BY total_cost DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input_total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output_total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_read"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reasoning"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm"
      },
      "description": "cache_read is included in input_total; reasoning is included in output_total."
    },
