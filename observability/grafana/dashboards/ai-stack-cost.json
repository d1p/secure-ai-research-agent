          "rawSql": "SELECT \"startTime\", model, \"user\", total_tokens, prompt_tokens, completion_tokens, COALESCE((metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint,0) AS cached_tokens, COALESCE((metadata->'usage_object'->'completion_tokens_details'->>'reasoning_tokens')::bigint,0) AS reasoning_tokens, ROUND(COALESCE((metadata->'cost_breakdown'->>'cache_read_cost')::float8,0)::numeric,6) AS cache_read, ROUND(COALESCE((metadata->'cost_breakdown'->>'reasoning_cost')::float8,0)::numeric,6) AS reasoning, ROUND(spend::numeric,6) AS spend, request_duration_ms AS duration_ms, status, session_id, litellm_call_id, request_id, custom_llm_provider FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' ORDER BY \"startTime\" DESC LIMIT 200",
