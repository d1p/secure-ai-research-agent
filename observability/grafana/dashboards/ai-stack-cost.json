    {
      "id": 7,
      "type": "timeseries",
      "title": "Spend over time (by model)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-litellm"
          },
          "rawSql": "SELECT $__timeGroup(\"startTime\",$__interval) AS time, model, SUM(spend) AS \"spend\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' GROUP BY 1,2 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens over time (prompt / completion / cached)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-litellm"
          },
          "rawSql": "SELECT $__timeGroup(\"startTime\",$__interval) AS time, SUM(\"prompt_tokens\") AS \"prompt\", SUM(\"completion_tokens\") AS \"completion\", SUM(COALESCE((metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint,0)) AS \"cached\", SUM(\"total_tokens\") AS \"total\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cost breakdown over time (input / output / cache / reasoning)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-litellm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-litellm"
          },
          "rawSql": "SELECT $__timeGroup(\"startTime\",$__interval) AS time, SUM(COALESCE((metadata->'cost_breakdown'->>'input_cost')::float8,0)) AS \"input\", SUM(COALESCE((metadata->'cost_breakdown'->>'output_cost')::float8,0)) AS \"output\", SUM(COALESCE((metadata->'cost_breakdown'->>'cache_read_cost')::float8,0)) AS \"cache_read\", SUM(COALESCE((metadata->'cost_breakdown'->>'reasoning_cost')::float8,0)) AS \"reasoning\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
