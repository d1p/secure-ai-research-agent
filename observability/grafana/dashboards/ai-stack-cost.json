          },
          "rawSql": "SELECT session_id, COUNT(*) AS requests, ROUND(SUM(spend)::numeric,6) AS cost, SUM(\"total_tokens\") AS tokens, SUM(COALESCE((metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint,0)) AS cached, MIN(\"startTime\") AS first_seen, MAX(\"startTime\") AS last_seen FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")\n  AND COALESCE(session_id,'') ~ '$session' AND session_id <> '' GROUP BY session_id ORDER BY cost DESC LIMIT 200",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
