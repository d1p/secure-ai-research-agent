# =============================================================================
# AI Stack — deployment secrets & settings (source: .env.example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Host / network ---------------------------------------------------------
# IP the two published host ports bind to (Open WebUI :3000, noVNC :6080).
BIND_IP=10.0.0.28
# Caddy PCT IP — the ONLY host allowed through the VM firewall for 3000/6080.
CADDY_PCT_IP=10.0.0.28
# Application domain proxied by Caddy (single-level subdomain).
APP_DOMAIN=ai.debashis.xyz

# --- Locale / timezone (never hardcode in image) ---------------------------
TZ=Europe/Berlin
BROWSER_LANG=en-US

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
# Strong random password (openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=postgres

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Open WebUI -------------------------------------------------------------
# Strong random secret (openssl rand -hex 32)
WEBUI_SECRET_KEY=CHANGE_ME_64_hex_chars
# Open WebUI talks to LiteLLM (OpenAI-compatible). Use the LiteLLM master key.
OPENWEBUI_OPENAI_API_KEY=sk-CHANGE_ME_litellm_master_key

# --- LiteLLM ----------------------------------------------------------------
# Must start with "sk-". Strong random value (openssl rand -hex 32).
LITELLM_MASTER_KEY=sk-CHANGE_ME_litellm_master_key
# Postgres URL for LiteLLM budget/spend state (same Postgres instance).
LITELLM_DATABASE_URL=postgresql://postgres:CHANGE_ME_postgres_password@postgres:5432/litellm

# --- Cloud LLM providers (credentials ONLY live here) ----------------------
# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# OpenAI
OPENAI_API_KEY=CHANGE_ME
# Google Gemini
GEMINI_API_KEY=CHANGE_ME
# DeepSeek
DEEPSEEK_API_KEY=CHANGE_ME

# --- LM Studio (LAN inference) ----------------------------------------------
# OpenAI-compatible endpoint of a LAN LM Studio server (e.g. http://10.0.0.20:1234/v1).
# LM Studio ignores the API key, but LiteLLM requires a non-empty value.
LMSTUDIO_BASE_URL=http://10.0.0.20:1234/v1
LMSTUDIO_API_KEY=lm-studio

# --- Service-to-service auth tokens ----------------------------------------
# Orchestrator -> gateway shared token (openssl rand -hex 32).
GATEWAY_TOKEN=CHANGE_ME_gateway_token
# Open WebUI -> orchestrator shared token.
ORCHESTRATOR_TOKEN=CHANGE_ME_orchestrator_token
# Open WebUI web-loader -> orchestrator token (openssl rand -hex 32).
# Open WebUI sends this as the external web loader API key.
WEB_LOADER_API_KEY=CHANGE_ME_web_loader_key

# --- Browser -----------------------------------------------------------------
# VNC password for noVNC (port 6080). Not reused anywhere else.
VNC_PASSWORD=CHANGE_ME_vnc_password
# Comma-separated domains the "personal" browser profile may visit (opt-in).
PERSONAL_ALLOW_DOMAINS=
# Model Stagehand uses (via LiteLLM) for act/observe/extract. Must support JSON
# output (DeepSeek's json_object mode is used). Default: deepseek-flash.
STAGEHAND_MODEL=deepseek-flash

# --- Coding runner ----------------------------------------------------------
# Git repositories exposed under /workspace (comma-separated repo name=url).
# Example: myrepo=https://github.com/me/myrepo.git
WORKSPACE_REPOS=CHANGE_ME_name=CHANGE_ME_url
# Runner image tag used by the orchestrator (built from orchestrator/runner).
RUNNER_IMAGE=ai-stack-agent-runner:latest

# --- Privacy (legacy but required by policy; see README) -------------------
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true

# --- Observability (Grafana / Prometheus / Tempo) ---------------------------
GRAFANA_ADMIN_USER=admin
# Strong random password (openssl rand -base64 18)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
# Public URL Grafana is served from (used for links/redirects behind Caddy).
GRAFANA_PUBLIC_URL=https://grafana.debashis.xyz
